+                call_name="nl_assertions_eval",
+                **DEFAULT_LLM_NL_ASSERTIONS_ARGS,
+            )
+            content = assistant_message.content or ""
+            object_start = content.find("{")
+            if object_start < 0:
+                last_error = json.JSONDecodeError("no JSON object in judge response", content, 0)
+                continue
+            candidate = content[object_start:]
+            for text in (candidate, _re.sub(r",\s*([}\]])", r"\1", candidate)):
+                try:
+                    result_data, _ = json.JSONDecoder().raw_decode(text)
+                    break
+                except json.JSONDecodeError as exc:
+                    last_error = exc
+                    result_data = None
+            if result_data is not None and isinstance(result_data, dict):
+                break
+        else:
+            raise last_error
